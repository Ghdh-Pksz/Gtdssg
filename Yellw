            Method = "GET"
        })
    end)

    if ok and res and res.Body and res.Body ~= "" and res.Body ~= "null" then
        local decOk, dados = pcall(function()
            return HttpService:JSONDecode(res.Body)
        end)
        if decOk and type(dados) == "table" and type(dados.expiraEm) == "number" then
            if os.time() < dados.expiraEm then
                return dados.expiraEm
            end
        end
    end
