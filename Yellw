            local hg = gethui()
            if hg then table.insert(roots, hg) end
        end
    end)
    return roots
end

local function guiPertenceAoHubFree(gui)
    if not gui or not gui:IsA("ScreenGui") then return false end
    local temTituloHub = false
    local temTituloAdmin = false
    for _, desc in ipairs(gui:GetDescendants()) do
        if desc:IsA("TextLabel") or desc:IsA("TextButton") then
            if desc.Text == "Brocasitx Hub" then
                temTituloHub = true
            elseif desc.Text == "Brocasitx Admin" then
                temTituloAdmin = true
            end
        end
    end
    return temTituloHub and not temTituloAdmin
end

local function aplicarCorVisualNaUI(bgMain, bgCard, textColor, strokeColor, accentColor)
    for _, root in ipairs(coletarRootsUI()) do
        for _, gui in ipairs(root:GetChildren()) do
            if guiPertenceAoHubFree(gui) then
                for _, desc in ipairs(gui:GetDescendants()) do
                    if desc:FindFirstAncestor("BrocasitxHeadTag") then
                        continue
                    end
                    if desc:IsA("Frame") or desc:IsA("ScrollingFrame") or desc:IsA("CanvasGroup") then
                        local sz = desc.AbsoluteSize
                        if sz.X >= 300 and sz.Y >= 220 then
                            desc.BackgroundColor3 = bgMain
                            if desc.BackgroundTransparency > 0.75 then
                                desc.BackgroundTransparency = 0.12
                            end
                        elseif sz.X >= 40 and sz.Y >= 18 then
                            if desc.BackgroundTransparency < 0.98 then
                                desc.BackgroundColor3 = bgCard
                            end
                        end
                    elseif desc:IsA("TextButton") then
                        if desc.BackgroundTransparency < 0.98 then
                            desc.BackgroundColor3 = accentColor
                        end
                        desc.TextColor3 = textColor
                    elseif desc:IsA("TextLabel") then
                        desc.TextColor3 = textColor
                    elseif desc:IsA("TextBox") then
                        if desc.BackgroundTransparency < 0.98 then
                            desc.BackgroundColor3 = bgCard
                        end
                        desc.TextColor3 = textColor
                    elseif desc:IsA("UIStroke") then
                        desc.Color = strokeColor
                    end
                end
            end
        end
    end
end

local function aplicarCorDoHub(corNome)
    corHubAtiva = corNome
    corHubVersao = corHubVersao + 1
    local minhaVersao = corHubVersao

    local function passoCor()
        if corNome == "Preto" then
            pcall(function()
                if type(Window.SetTheme) == "function" then
                    Window:SetTheme("Dark")
                end
            end)
            aplicarCorVisualNaUI(
                Color3.fromRGB(10, 10, 10),
                Color3.fromRGB(24, 24, 24),
                Color3.fromRGB(255, 255, 255),
                Color3.fromRGB(65, 65, 65),
                Color3.fromRGB(36, 36, 36)
            )
        elseif corNome == "Branco" then
            pcall(function()
                if type(Window.SetTheme) == "function" then
                    Window:SetTheme("Light")
                end
            end)
            aplicarCorVisualNaUI(
                Color3.fromRGB(244, 246, 250),
                Color3.fromRGB(255, 255, 255),
                Color3.fromRGB(15, 15, 20),
                Color3.fromRGB(175, 185, 200),
                Color3.fromRGB(220, 226, 236)
            )
        elseif corNome == "Verde" then
            pcall(function()
                if type(Window.SetTheme) == "function" then
                    Window:SetTheme("Dark")
                end
            end)
            aplicarCorVisualNaUI(
                Color3.fromRGB(8, 36, 18),
                Color3.fromRGB(16, 62, 32),
                Color3.fromRGB(225, 255, 235),
                Color3.fromRGB(45, 205, 110),
                Color3.fromRGB(24, 95, 48)
            )
        end
    end

    passoCor()
    task.spawn(function()
        for _ = 1, 6 do
            task.wait(0.1)
            if corHubVersao ~= minhaVersao then break end
            passoCor()
        end
    end)
end

