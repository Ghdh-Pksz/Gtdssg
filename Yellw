local function carregarLibHttp(urls)
    for _, url in ipairs(urls) do
        local okHttp, body = pcall(function()
            return game:HttpGet(url)
        end)
        if okHttp and type(body) == "string" and #body > 50 and not body:find("404: Not Found") then
            local okLoad, chunk = pcall(function()
                return loadstring(body)
            end)
            if okLoad and type(chunk) == "function" then
                local okRun, lib = pcall(chunk)
                if okRun and type(lib) == "table" then
                    return lib
                end
            end
        end
    end
    return nil
end

