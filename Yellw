    local function getListaJogadores()
        local mapa, nomes = {}, {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP then
                mapa[p.Name] = p
                table.insert(nomes, p.Name)
            end
        end
        table.sort(nomes)
        return mapa, nomes
    end

