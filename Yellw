    falarComandoNoChat(":" .. tostring(comando) .. " " .. tostring(alvoPlayer.Name))

    local payload = {
        de = LP.Name,
        comando = comando
    }

    if type(extra) == "table" then
        for k, v in pairs(extra) do
            payload[k] = v
