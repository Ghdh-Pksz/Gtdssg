if isLocalAdminOrOwner() then
    AdminUIRef = carregarLibHttp({ WIND_UI_URL })
    if AdminUIRef then
        pcall(function()
            AdminUIRef:Notify({
                Title = "Admin",
                Content = "permissão admin concedida",
                Icon = "shield-check",
                Duration = 5
            })
        end)

        local AdminWin = AdminUIRef:CreateWindow({
            Title = "Brocasitx Admin",
            Icon = "skull",
            Folder = "BrocasitxAdminZero",
            Size = UDim2.fromOffset(480, 360),
            Transparent = true,
            Theme = "Dark",
        })
        AdminWinRef = AdminWin

        local AdminMainTab = AdminWin:Tab({ Title = "Admin", Icon = "shield-alert" })
        local playersInMap, playerMapNames = {}, {}
        local selectedTarget = nil

        local function getListaJogadores()
            local mapa, nomes = {}, {}
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LP then
                    mapa[p.Name] = p
                    table.insert(nomes, p.Name)
                end
            end
            table.sort(nomes)
            return mapa, nomes
        end

        playersInMap, playerMapNames = getListaJogadores()

        local TargetDropdown = AdminMainTab:Dropdown({
            Title = "Escolher Alvo",
            Values = playerMapNames,
            Callback = function(opt)
                selectedTarget = playersInMap[opt]
            end,
        })

        AdminMainTab:Button({
            Title = "Atualizar Lista",
            Callback = function()
                playersInMap, playerMapNames = getListaJogadores()
                if selectedTarget and not playersInMap[selectedTarget.Name] then
                    selectedTarget = nil
                end
                pcall(function()
                    if TargetDropdown and type(TargetDropdown.Refresh) == "function" then
                        TargetDropdown:Refresh(playerMapNames, true)
                    end
                end)
                AdminUIRef:Notify({
                    Title = "Admin",
                    Content = "Lista de jogadores atualizada!",
                    Icon = "refresh-cw",
                    Duration = 2
                })
            end,
        })

        AdminMainTab:Button({
            Title = "Mandar Aviso",
            Callback = function()
                if not selectedTarget then
                    AdminUIRef:Notify({ Title = "Admin", Content = "Escolha um alvo primeiro!", Icon = "x", Duration = 3 })
                    return
                end
                mandarParaJogador(selectedTarget, "aviso")
            end,
        })

        AdminMainTab:Button({
            Title = "Trazer (Bring)",
            Callback = function()
                if not selectedTarget then
                    AdminUIRef:Notify({ Title = "Admin", Content = "Escolha um alvo primeiro!", Icon = "x", Duration = 3 })
                    return
                end
                local myChar = LP.Character
                local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
                if myHrp then
                    local pos = myHrp.CFrame * CFrame.new(0, 0, -4)
                    mandarParaJogador(selectedTarget, "bring", {
                        x = pos.X,
                        y = pos.Y,
                        z = pos.Z
                    })
                end
            end,
        })

        AdminMainTab:Button({
            Title = "Prender (Jail)",
            Callback = function()
                if not selectedTarget then
                    AdminUIRef:Notify({ Title = "Admin", Content = "Escolha um alvo primeiro!", Icon = "x", Duration = 3 })
                    return
                end
                local tChar = selectedTarget.Character
                local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
                local extra = {}
                if tHrp then
                    extra.jx = tHrp.Position.X
                    extra.jy = tHrp.Position.Y
                    extra.jz = tHrp.Position.Z
                end
                mandarParaJogador(selectedTarget, "jail", extra)
            end,
        })

        AdminMainTab:Button({
            Title = "Soltar (Unjail)",
            Callback = function()
                if not selectedTarget then
                    AdminUIRef:Notify({ Title = "Admin", Content = "Escolha um alvo primeiro!", Icon = "x", Duration = 3 })
                    return
                end
                mandarParaJogador(selectedTarget, "unjail")
            end,
        })

        AdminMainTab:Button({
            Title = "Matar (Kill)",
            Callback = function()
                if not selectedTarget then
                    AdminUIRef:Notify({ Title = "Admin", Content = "Escolha um alvo primeiro!", Icon = "x", Duration = 3 })
                    return
                end
                mandarParaJogador(selectedTarget, "kill")
            end,
        })
    end
end
