local function atualizarDropdownRedz(dropObj, novaLista)
    if not dropObj then return end
    local listaSegura = type(novaLista) == "table" and novaLista or {}
    pcall(function()
        if type(dropObj.Refresh) == "function" then
            dropObj:Refresh(listaSegura, true)
            return
        end
        if type(dropObj.Set) == "function" then
            dropObj:Set(listaSegura)
            return
        end
        if type(dropObj.Clear) == "function" and type(dropObj.Add) == "function" then
            dropObj:Clear()
            for _, item in ipairs(listaSegura) do
                dropObj:Add(item)
            end
        end
    end)
end

local function pedirHttp(dados)
