local function obterAlturaVoidSegura()
    local fallHeight = tonumber(workspace.FallenPartsDestroyHeight) or -500
    if fallHeight > -100 then
        return fallHeight + 12
    end
    return math.max(fallHeight + 25, -240)
end

local function executarFlingComCarrinho(alvoPlayer)
    if not alvoPlayer or not alvoPlayer.Character then
        return false, "Alvo inválido ou sem personagem."
    end

    local tChar = alvoPlayer.Character
    local tHrp = tChar:FindFirstChild("HumanoidRootPart")
    local tHum = tChar:FindFirstChildOfClass("Humanoid")
    local myChar = LP.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")

    if not tHrp or not myHrp or not myHum then
        return false, "Personagens não encontrados."
    end

    local origCF = myHrp.CFrame
    local voidY = obterAlturaVoidSegura()

    pcall(function()
        local re = ReplicatedStorage:FindFirstChild("RE")
        local toolRemote = re and re:FindFirstChild("1Too1l")
        if toolRemote and toolRemote:IsA("RemoteFunction") then
            toolRemote:InvokeServer("PickingTools", "ShoppingCart")
        elseif toolRemote and toolRemote:IsA("RemoteEvent") then
            toolRemote:FireServer("PickingTools", "ShoppingCart")
        end
    end)

    task.wait(0.25)

    local cart = myChar:FindFirstChild("ShoppingCart") or (LP:FindFirstChild("Backpack") and LP.Backpack:FindFirstChild("ShoppingCart"))
    if cart and cart:IsA("Tool") and cart.Parent ~= myChar then
        pcall(function()
            myHum:EquipTool(cart)
        end)
        task.wait(0.15)
    end

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    bv.Velocity = Vector3.zero
    bv.Parent = myHrp

    local bav = Instance.new("BodyAngularVelocity")
    bav.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    bav.AngularVelocity = Vector3.new(0, 90, 0)
    bav.Parent = myHrp

    local etapaSentarInicio = os.clock()
    while (os.clock() - etapaSentarInicio) < 0.85 do
        if not alvoPlayer.Parent or not tHrp.Parent or not myHrp.Parent then break end
        if tHum then
            pcall(function()
                tHum:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
                tHum.Sit = true
            end)
        end
        local encostoPerna = tHrp.CFrame * CFrame.new(0, -1.6, -0.7)
        myHrp.CFrame = encostoPerna * CFrame.Angles(0, math.rad(os.clock() * 720), 0)
        bv.Velocity = Vector3.zero
        RunService.Heartbeat:Wait()
    end

    local etapaVoidInicio = os.clock()
    while (os.clock() - etapaVoidInicio) < 1.1 do
        if not alvoPlayer.Parent or not tHrp.Parent or not myHrp.Parent then break end
        if tHum then
            pcall(function()
                tHum:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
                tHum.Sit = true
            end)
        end
        local posVoid = CFrame.new(tHrp.Position.X, voidY, tHrp.Position.Z) * CFrame.Angles(0, math.rad(os.clock() * 900), 0)
        myHrp.CFrame = posVoid
        bv.Velocity = Vector3.new(0, -85, 0)
        RunService.Heartbeat:Wait()
    end

    if tHum then
        pcall(function()
            tHum.Sit = false
        end)
    end
    if tHrp and tHrp.Parent then
        pcall(function()
            tHrp.CFrame = CFrame.new(tHrp.Position.X, voidY - 15, tHrp.Position.Z)
        end)
    end

    task.wait(0.1)

    pcall(function() bv:Destroy() end)
    pcall(function() bav:Destroy() end)

    if myHrp and myHrp.Parent then
        pcall(function()
            myHrp.AssemblyLinearVelocity = Vector3.zero
            myHrp.AssemblyAngularVelocity = Vector3.zero
            myHrp.CFrame = origCF
        end)
    end

    return true, nil
end

local babyFollowToken = 0
local babyOscSpeed = 6.5
local babyLocalEscolhido = "Nas Costas"

local function buscarFollowCharacterManual()
    local char = LP.Character or workspace:FindFirstChild(LP.Name)
    if char then
        local fc = char:FindFirstChild("FollowCharacter")
        if fc then return fc end
    end
    return workspace:FindFirstChild("FollowCharacter")
end

local function posicionarObjetoEmCFrame(obj, destino)
    if not obj or not obj.Parent or not destino then return end
    pcall(function()
        if obj:IsA("Model") then
            for _, p in ipairs(obj:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.AssemblyLinearVelocity = Vector3.zero
                    p.AssemblyAngularVelocity = Vector3.zero
                end
            end
            obj:PivotTo(destino)
        elseif obj:IsA("BasePart") then
            obj.AssemblyLinearVelocity = Vector3.zero
            obj.AssemblyAngularVelocity = Vector3.zero
            obj.CFrame = destino
        elseif obj:IsA("Humanoid") and obj.Parent then
            for _, p in ipairs(obj.Parent:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.AssemblyLinearVelocity = Vector3.zero
                    p.AssemblyAngularVelocity = Vector3.zero
                end
            end
            obj.Parent:PivotTo(destino)
        end
    end)
end

local function moverBabyOscilando(obj, targetChar)
    if not obj or not obj.Parent or not targetChar then return end
    local onda = math.sin(os.clock() * babyOscSpeed)
    local destino = nil

    if babyLocalEscolhido == "Na Cara" then
        local head = targetChar:FindFirstChild("Head")
        local ref = head or targetChar:FindFirstChild("HumanoidRootPart")
        if not ref or not ref.Parent then return end

        local offsetZ = -1.65 - (onda * 0.75) -- na frente da cara/cabeça indo e voltando
        local offsetY = head and (-0.15 + (onda * 0.12)) or (1.35 + (onda * 0.12))
        destino = ref.CFrame * CFrame.new(0, offsetY, offsetZ) * CFrame.Angles(0, math.pi, 0)
    else
        local hrp = targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChild("UpperTorso") or targetChar:FindFirstChild("Torso")
        if not hrp or not hrp.Parent then return end

        local offsetZ = 1.65 + (onda * 0.85) -- atrás nas costas indo e voltando
        local offsetY = -0.55 + (onda * 0.12) -- um pouco pra baixo
        destino = hrp.CFrame * CFrame.new(0, offsetY, offsetZ)
    end

    posicionarObjetoEmCFrame(obj, destino)
end

local function enviarBabyParaAlvo(alvoPlayer, _nomeBaby)
    if not alvoPlayer or not alvoPlayer.Character then
        return false, "Escolha um alvo válido primeiro!"
    end

    local tChar = alvoPlayer.Character
    local tRef = tChar:FindFirstChild("HumanoidRootPart") or tChar:FindFirstChild("Head")
    if not tRef then
        return false, "Personagem do alvo não encontrado."
    end

    local fcInicial = buscarFollowCharacterManual()
    if not fcInicial or not fcInicial.Parent then
        return false, "Spawne o baby manualmente primeiro!"
    end

    babyFollowToken = babyFollowToken + 1
    local meuToken = babyFollowToken

    task.spawn(function()
        while babyFollowToken == meuToken do
            if not alvoPlayer.Parent or not alvoPlayer.Character then break end

            local fc = buscarFollowCharacterManual()
            if not fc or not fc.Parent then break end

            moverBabyOscilando(fc, alvoPlayer.Character)
            RunService.Heartbeat:Wait()
        end
    end)

    return true, nil
end

local function removerBabyDoAlvo()
    babyFollowToken = babyFollowToken + 1
    local fc = buscarFollowCharacterManual()
    if fc and fc.Parent then
        local myChar = LP.Character or workspace:FindFirstChild(LP.Name)
        local myHrp = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Head"))
        if myHrp and myHrp.Parent then
            posicionarObjetoEmCFrame(fc, myHrp.CFrame * CFrame.new(0, 0, -2.5))
        end
        return true, nil
    end
    return false, "Nenhum baby encontrado no momento."
end

local function enviarVelocidadeCarro(velNum)
    local num = tonumber(velNum)
    if not num then return false, "Digite uma velocidade válida!" end

    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local ev = remotes and remotes:FindFirstChild("SetMaxSpeed")
    if not ev then return false, "Remote SetMaxSpeed não encontrado." end

    local ok, err = pcall(function()
        if ev:IsA("RemoteFunction") then
            ev:InvokeServer(num)
        elseif ev:IsA("RemoteEvent") then
            ev:FireServer(num)
        end
    end)
    return ok, ok and nil or tostring(err)
end

