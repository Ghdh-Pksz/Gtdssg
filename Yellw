local jailSpawnCFrame = nil
local isJailedLocal = false

local function criarJaulaEm(targetPlayer, customCFrame)
    if not targetPlayer or not targetPlayer.Character then return end
    local hrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local centerCF = customCFrame or hrp.CFrame

    local oldJail = workspace:FindFirstChild("IceJail_" .. targetPlayer.Name)
    if oldJail then oldJail:Destroy() end

    local jail = Instance.new("Model")
    jail.Name = "IceJail_" .. targetPlayer.Name
    jail.Parent = workspace

    local function makeWall(size, cf)
        local p = Instance.new("Part")
        p.Size = size
        p.CFrame = centerCF * cf
        p.Anchored = true
        p.CanCollide = true
        p.Material = Enum.Material.Ice
        p.Color = Color3.fromRGB(0, 150, 255)
        p.Transparency = 0.4
        p.Parent = jail
    end

    makeWall(Vector3.new(10, 1, 10), CFrame.new(0, -4, 0))
    makeWall(Vector3.new(10, 1, 10), CFrame.new(0, 8, 0))
    makeWall(Vector3.new(10, 12, 1), CFrame.new(0, 2, -5))
    makeWall(Vector3.new(10, 12, 1), CFrame.new(0, 2, 5))
    makeWall(Vector3.new(1, 12, 10), CFrame.new(-5, 2, 0))
    makeWall(Vector3.new(1, 12, 10), CFrame.new(5, 2, 0))
end

local function removerJaulaDe(targetPlayer)
    if not targetPlayer then return end
    local jail = workspace:FindFirstChild("IceJail_" .. targetPlayer.Name)
    if jail then jail:Destroy() end
end

local function prenderLocalNoJail(dados)
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local baseCF = hrp and hrp.CFrame or CFrame.new(0, 10, 0)

    if dados and dados.jx and dados.jy and dados.jz then
        baseCF = CFrame.new(tonumber(dados.jx), tonumber(dados.jy), tonumber(dados.jz))
    end

    jailSpawnCFrame = baseCF
    isJailedLocal = true

    if hrp then
        pcall(function() hrp.CFrame = jailSpawnCFrame end)
    end
    criarJaulaEm(LP, jailSpawnCFrame)
end

local function soltarLocalDoJail()
    isJailedLocal = false
    jailSpawnCFrame = nil
    removerJaulaDe(LP)
end

