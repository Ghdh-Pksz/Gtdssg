local function getBoomboxEquipada()
    local char = LP.Character
    local boombox = char and char:FindFirstChild("Boombox")
    return (boombox and boombox:IsA("Tool")) and boombox or nil
end

local function playMusic(soundId)
    soundId = tostring(soundId)
    if not tonumber(soundId) then return false, "ID inválido" end

    local boombox = getBoomboxEquipada()
    if not boombox then return false, "Equipe a Boombox na mão primeiro!" end

    local sound = boombox:FindFirstChildWhichIsA("Sound", true)
    if sound then
        sound.SoundId = "rbxassetid://" .. soundId
        sound.Looped = true
        sound.Volume = 0.5
        sound:Play()
    end

    local RE = ReplicatedStorage:FindFirstChild("RE")
    local remote = RE and RE:FindFirstChild("PlayerToolEvent")
    if remote then
        pcall(function() remote:FireServer("ToolMusicText", soundId, nil, true) end)
        return true, nil
    end
    return false, "Remote PlayerToolEvent não encontrado."
end

MusicTab:AddDropdown({
    Name = "Catálogo de Músicas",
    Description = "Escolha uma música para tocar.",
    Options = songNames,
    Callback = function(Option)
        local id = savedSongs[Option]
        if id then
            local ok, err = playMusic(id)
            notificar(ok and "Música" or "Erro", ok and ("Tocando " .. Option .. " na Boombox!") or err, 3)
        end
    end
})

MusicTab:AddSection({ "Controle" })
local customAudioId = ""

MusicTab:AddTextBox({
    Name = "ID Customizado",
    Description = "Ex: 1837879082",
    PlaceholderText = "Ex: 1837879082",
    Callback = function(txt)
        customAudioId = tostring(txt or "")
    end
})

MusicTab:AddButton({
    "Tocar ID Customizado",
    function()
        if customAudioId and customAudioId ~= "" then
            local ok, err = playMusic(customAudioId)
            if not ok then notificar("Erro", err, 4) end
        end
    end
})

MusicTab:AddButton({
    "Pausar Música",
    function()
        local boombox = getBoomboxEquipada()
        if boombox then
            local sound = boombox:FindFirstChildWhichIsA("Sound", true)
            if sound then sound:Stop() end
            local RE = ReplicatedStorage:FindFirstChild("RE")
            local remote = RE and RE:FindFirstChild("PlayerToolEvent")
            if remote then pcall(function() remote:FireServer("ToolMusicText", "", nil, true) end) end
        else
            notificar("Erro", "Equipe a Boombox na mão!", 4)
        end
    end
})

