local antiSitEnabled = false
local savedSeatCollide = {}
local charConnections = {}

local function desativarSeat(seat)
    if not seat or not (seat:IsA("Seat") or seat:IsA("VehicleSeat")) then return end
    if savedSeatCollide[seat] == nil then
        savedSeatCollide[seat] = seat.CanCollide
    end
    pcall(function() seat.CanCollide = false end)
end

local function bloquearSentarNoHumanoid(hum)
    if not hum then return end
    pcall(function()
        hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
    end)
    hum.Sit = false
    if hum.SeatPart then
        desativarSeat(hum.SeatPart)
    end
end

local function limparSeatWelds(char)
    if not char then return end
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Weld") and child.Name == "SeatWeld" then
            child:Destroy()
        end
    end
end

local function restaurarAssentosAlterados()
    for seat, origCollide in pairs(savedSeatCollide) do
        if seat and seat.Parent then
            pcall(function()
                seat.CanCollide = origCollide
            end)
        end
        savedSeatCollide[seat] = nil
    end
end

local function restaurarEstadoSeatedHumanoid()
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        pcall(function()
            hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
        end)
    end
end

local function desconectarPersonagemAntiSit()
    for _, conn in ipairs(charConnections) do
        pcall(function() conn:Disconnect() end)
    end
    charConnections = {}
end

local function conectarParteTouchedAntiSit(part)
    if not part:IsA("BasePart") then return end
    table.insert(charConnections, part.Touched:Connect(function(hit)
        if not antiSitEnabled then return end
        if hit and (hit:IsA("Seat") or hit:IsA("VehicleSeat")) then
            desativarSeat(hit)
        end
    end))
end

local function conectarHumanoidAntiSit(char, hum)
    if not char or not hum then return end
    pcall(function()
        hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
    end)
    table.insert(charConnections, hum.Seated:Connect(function(active, currentSeatPart)
        if not antiSitEnabled or not active then return end
        if currentSeatPart then
            desativarSeat(currentSeatPart)
        end
        bloquearSentarNoHumanoid(hum)
        limparSeatWelds(char)
    end))
end

local function ligarAntiSitEmPersonagem(char)
    desconectarPersonagemAntiSit()
    if not char then return end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        conectarHumanoidAntiSit(char, hum)
        if hum.Sit then
            bloquearSentarNoHumanoid(hum)
            limparSeatWelds(char)
        end
    end

    for _, desc in ipairs(char:GetDescendants()) do
        if desc:IsA("BasePart") then
            conectarParteTouchedAntiSit(desc)
        end
    end

    table.insert(charConnections, char.DescendantAdded:Connect(function(desc)
        if not antiSitEnabled then return end
        if desc:IsA("BasePart") then
            conectarParteTouchedAntiSit(desc)
        elseif desc:IsA("Humanoid") then
            conectarHumanoidAntiSit(char, desc)
        elseif desc:IsA("Weld") and desc.Name == "SeatWeld" then
            desc:Destroy()
            local h = char:FindFirstChildOfClass("Humanoid")
            bloquearSentarNoHumanoid(h)
        end
    end))
end

local overlapParams = OverlapParams.new()
overlapParams.FilterType = Enum.RaycastFilterType.Exclude

local function desativarCollideDeAssentosProximos(char)
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    overlapParams.FilterDescendantsInstances = { char }

    local partesProximas = workspace:GetPartBoundsInRadius(hrp.Position, 22, overlapParams)
    for _, part in ipairs(partesProximas) do
        if part:IsA("Seat") or part:IsA("VehicleSeat") then
            desativarSeat(part)
        end
    end
end

